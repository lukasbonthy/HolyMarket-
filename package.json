{
  "name":"holymarket",
  "version":"5.1.0",
  "type":"module",
  "private":true,
  "engines":{"node":">=20"},
  "scripts":{
    "css:build":"npx @tailwindcss/cli -i ./src/tailwind-v9.css -o ./src/tailwind-v9.generated.css --minify",
    "dev":"npm run css:build && node server.mjs",
    "start":"npm run css:build && node server.mjs",
    "test":"node --test tests/*.test.mjs",
    "build":"npm run css:build && node scripts-build.mjs"
  },
  "dependencies":{
    "bcryptjs":"^3.0.3",
    "express":"^5.2.1",
    "express-session":"^1.19.0"
  },
  "devDependencies":{
    "tailwindcss":"^4.3.0",
    "@tailwindcss/cli":"^4.3.0"
  }
}
